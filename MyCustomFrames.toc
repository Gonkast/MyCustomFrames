# Instrumentacion de los caminos calientes (tickers/OnUpdate permanentes).
# Apagada por defecto: con `active` en false el wrapper solo hace una
# comparacion booleana. Se enciende con /mcfdiag hot.
#
# ANTES que core.lua, no despues: core crea su ticker de 0.1s a nivel de
# ARCHIVO, o sea al cargarse. Con Profiler.lua detras, ns.Prof todavia no
# existia en ese momento y core.lua:2366 reventaba con "attempt to index field
# '?' (a nil value)". No depende de nada del addon -- solo define funciones.
Profiler.lua

core.lua

# Puente centralizado a APIs de Blizzard que cambian de comportamiento entre
# versiones (ej. UnitHealthPercent/UnitPowerPercent + curva) -- un solo lugar
# para arreglar en vez de N copias sueltas por archivo. Carga temprano para
# que el resto del addon pueda usarlo.
API.lua

# INDICADORES (range fade / shield bar) para las unitframes individuales --
